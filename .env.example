# Set this in the deployment environment before launch.
# It drives canonical URLs, Open Graph URLs, sitemap URLs, and the robots sitemap entry.
PUBLIC_SITE_URL=https://your-domain.example

# Optional browser analytics. Keep the provider as none to disable analytics.
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_OPENPANEL_CLIENT_ID=
# Leave this blank for OpenPanel Cloud. For self-hosting, use the instance API URL,
# normally ending in /api. This is a public browser endpoint, not a server secret.
PUBLIC_OPENPANEL_API_URL=
PUBLIC_OPENPANEL_SCRIPT_URL=https://openpanel.dev/op1.js
PUBLIC_ANALYTICS_ENVIRONMENT=production
PUBLIC_ANALYTICS_REQUIRE_CONSENT=false
PUBLIC_ANALYTICS_RESPECT_DNT=true

# Future, explicit Cloudflare commands only. Keep the token in a secret manager or
# this ignored .env file; never commit a real token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set true to reuse an authenticated local Wrangler OAuth session instead of a token.
CLOUDFLARE_USE_WRANGLER_AUTH=false
CLOUDFLARE_PAGES_PROJECT=intelip-portfolio
CLOUDFLARE_PAGES_BRANCH=
CLOUDFLARE_DEPLOY_CONFIRM=
