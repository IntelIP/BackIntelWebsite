# Set this in the deployment environment before launch.
# It drives canonical URLs, Open Graph URLs, sitemap URLs, and the robots sitemap entry.
PUBLIC_SITE_URL=https://your-domain.example

# Optional browser analytics. Leave the provider empty to keep analytics disabled.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_OPENPANEL_CLIENT_ID=
PUBLIC_OPENPANEL_API_URL=
PUBLIC_OPENPANEL_SCRIPT_URL=https://openpanel.dev/op1.js

# Future, explicit Cloudflare commands only. Keep the token in a secret manager or
# this ignored .env file; never commit a real token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=intelip-portfolio
CLOUDFLARE_PAGES_BRANCH=
CLOUDFLARE_DEPLOY_CONFIRM=
