{
  "schemaVersion": "tabellio-validation/v0.2",
  "id": "backintel-website-demo",
  "requireEntireCheckpoint": false,
  "failFast": true,
  "acceptance": {
    "id": "backintel-business-technology-website",
    "source": "docs/release/WebsiteRevisionPlan.txt and the approved execution request",
    "risk": "medium",
    "outcomes": [
      "Explain BackIntel as an autonomous agent for data engineering, data science and dataset analysis, with approved workflow execution and human oversight.",
      "Use the simplified opening: one GitHub action at the header right, no hero buttons or audience note, followed by workflow pain, output, visible technology and supporting examples.",
      "Match the demo purple palette and Instrument Sans; show the actual selected case with full 2x screenshot pixel coverage on desktop and mobile.",
      "Expose all five recorded stages on desktop and mobile and show public MIT GitHub source links.",
      "Keep static meaning, accessibility and business-focused SEO; require an explicit public origin and keep previews out of search."
    ],
    "invariants": [
      "Static page; no provider calls, visitor persistence, production writes or analytics by default.",
      "Synthetic data and unmeasured customer accuracy and business value stay visible.",
      "The page uses product tokens, self-hosted fonts and reduced-motion behavior.",
      "MIT licensing and GitHub source publication are authorized. Public hosting and domains remain separately authorized."
    ],
    "forbiddenOutcomes": [
      "SSR, database access, external deployment, or secret use is introduced by the prototype.",
      "A validation command performs a Cloudflare, domain, analytics, or billing write.",
      "Visitor changes in the demo are represented as production data or persisted outside the mockup.",
      "Visual readiness is reported without rendered review."
    ],
    "requiredValidatorTypes": [
      "static",
      "schema",
      "workflow"
    ]
  },
  "validators": [
    {
      "id": "design-profile-schema",
      "type": "schema",
      "argv": [
        "npm",
        "run",
        "validate:profile"
      ],
      "cwd": ".",
      "timeoutMs": 30000,
      "required": true,
      "evidence": {
        "path": "artifacts/validation/design-profile.json"
      },
      "policy": {
        "metricThresholds": [],
        "maxCostUsd": null,
        "requireCostTelemetry": false
      }
    },
    {
      "id": "astro-static-build",
      "type": "static",
      "argv": [
        "npm",
        "run",
        "build:validation"
      ],
      "cwd": ".",
