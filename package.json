{
  "name": "backintel-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/validate-built-site.mjs",
    "build:validation": "node scripts/run-build-validation.mjs",
    "package": "node scripts/package-site.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "new:product": "node scripts/new-product.mjs",
    "domain:search": "node scripts/domains.mjs search",
    "domain:check": "node scripts/domains.mjs check",
    "validate:launch-kit": "node scripts/validate-launch-kit.mjs",
    "test:product-kit": "node scripts/test-product-kit.mjs",
    "test:live-mockup": "node scripts/test-live-mockup.mjs",
    "test:analytics": "node --experimental-strip-types scripts/test-analytics.ts",
    "assets:demo": "node scripts/build-readme-demo.mjs",
    "lighthouse:ci": "lhci autorun --config=./lighthouserc.json",
    "typecheck": "node scripts/run-typecheck.mjs",
    "preview": "astro preview",
    "validate:profile": "node scripts/validate-design-profile.mjs",
    "assets:social": "node scripts/build-backintel-social.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "0.15.1",
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "puppeteer-core": "25.10.0"
  },
  "overrides": {
    "@lhci/cli": {
      "@puppeteer/browsers": "3.2.2",
      "proxy-agent": "8.0.2",
      "puppeteer-core": "25.10.0",
      "qs": "6.16.0",
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    }
  },
  "license": "MIT"
}
