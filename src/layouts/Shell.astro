---
import "../styles/global.css";
import { absoluteUrl, siteName, siteOrigin } from "../config/site";

const {
  title = "IntelIP — Product systems with a signal",
  description = "A shared home for focused products, useful experiments, and the evidence behind how they are built.",
  image,
  imageAlt,
  type = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonicalUrl = siteOrigin ? absoluteUrl(Astro.url.pathname) : "";
const imageUrl = image && siteOrigin ? absoluteUrl(image) : "";
const serializedJsonLd = jsonLd.length
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : "";
const openPanelClientId = (import.meta.env.PUBLIC_OPENPANEL_CLIENT_ID ?? "").trim();
const openPanelApiUrl = (import.meta.env.PUBLIC_OPENPANEL_API_URL ?? "").trim();
const openPanelScriptUrl = (
  import.meta.env.PUBLIC_OPENPANEL_SCRIPT_URL ?? "https://openpanel.dev/op1.js"
).trim();
const openPanelEnabled =
  import.meta.env.PUBLIC_ANALYTICS_PROVIDER === "openpanel" && Boolean(openPanelClientId);
const openPanelConfig = JSON.stringify({
  ...(openPanelApiUrl ? { apiUrl: openPanelApiUrl } : {}),
  clientId: openPanelClientId,
  trackScreenViews: true,
  trackOutgoingLinks: true,
  trackAttributes: true,
}).replace(/</g, "\\u003c");
const openPanelBootstrap = `window.op=window.op||function(){var n=[];return new Proxy(function(){arguments.length&&n.push([].slice.call(arguments))},{get:function(t,r){return"q"===r?n:function(){n.push([r].concat([].slice.call(arguments)))}} ,has:function(t,r){return"q"===r}}) }();window.op('init',${openPanelConfig});`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}
    {openPanelEnabled && <script is:inline set:html={openPanelBootstrap} />}
    {openPanelEnabled && <script is:inline async defer src={openPanelScriptUrl} />}
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
