---
import "../styles/global.css";
import { absoluteUrl, siteName, siteOrigin } from "../config/site";
import { readAnalyticsConfig } from "../analytics/config.ts";
import { getBrowserAnalyticsRuntime } from "../analytics/browser.ts";

const {
  title = "IntelIP — Product systems with a signal",
  description = "A shared home for focused products, useful experiments, and the evidence behind how they are built.",
  image,
  imageAlt,
  type = "website",
  noindex = false,
  jsonLd = [],
  analyticsProject = siteName,
  analyticsEnvironment = import.meta.env.PUBLIC_ANALYTICS_ENVIRONMENT ??
    (import.meta.env.DEV ? "development" : "production"),
} = Astro.props;

const canonicalUrl = siteOrigin ? absoluteUrl(Astro.url.pathname) : "";
const imageUrl = image && siteOrigin ? absoluteUrl(image) : "";
const serializedJsonLd = jsonLd.length
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : "";
const analyticsConfig = readAnalyticsConfig(import.meta.env, {
  project: analyticsProject,
  environment: analyticsEnvironment,
  route: Astro.url.pathname,
});
const analyticsRuntime = getBrowserAnalyticsRuntime(analyticsConfig);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site index" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}
    {analyticsRuntime.enabled && (
      <meta
        name="intelip-analytics-config"
        content={JSON.stringify(analyticsConfig)}
      />
    )}
    {analyticsRuntime.bootstrap && (
      <script is:inline set:html={analyticsRuntime.bootstrap} />
    )}
    {analyticsRuntime.scriptUrl && (
      <script is:inline async defer src={analyticsRuntime.scriptUrl} />
    )}
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
    {analyticsRuntime.enabled && (
      <script src="../analytics/client-entry.ts"></script>
    )}
  </body>
</html>
