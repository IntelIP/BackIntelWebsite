---
import { getCollection, render } from "astro:content";
import ProductPage from "../../components/ProductPage.astro";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ id, data }) =>
    data.visibility === "public" && id !== "backintel",
  );

  return Promise.all(
    products.map(async (entry) => {
      const { Content } = await render(entry);
      return {
        params: { slug: entry.id },
        props: { product: entry.data, Content },
      };
    }),
  );
}

const { product, Content } = Astro.props;
---

<ProductPage product={product} slug={Astro.params.slug} Content={Content} />
